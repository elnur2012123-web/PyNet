# ---- Supabase (required for accounts, leaderboard, subscriptions) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI tutor (PyBuddy) ----
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" after enabling the Google provider in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ---- Payments: Lemon Squeezy (merchant of record, supports payouts to Uzbekistan) ----
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_MAX_MONTHLY=
LEMONSQUEEZY_VARIANT_MAX_YEARLY=

# ---- Cron (leaderboard snapshots). Vercel sends this as a Bearer token ----
CRON_SECRET=
